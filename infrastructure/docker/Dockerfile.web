# Frontend Dockerfile
FROM node:18-alpine

WORKDIR /app

# Install dependencies
COPY apps/web/package*.json ./
RUN npm install

# Copy design-schema package
COPY packages/design-schema /app/design-schema

# Copy application code
COPY apps/web .

# Expose port
EXPOSE 3000

# Environment variables
ENV NODE_ENV=development

# Run development server
CMD ["npm", "run", "dev"]
