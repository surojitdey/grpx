# Django Settings
DJANGO_SECRET_KEY=your-secret-key-change-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Configuration
DB_ENGINE=django.db.backends.postgresql
DB_NAME=design_platform
DB_USER=design_user
DB_PASSWORD=design_password
DB_HOST=localhost
DB_PORT=5432

# Test Database Configuration (optional)
# Tests never use DB_NAME; they default to <DB_NAME>_test. See .env.test.example
# if you want to point them at a different server or credentials.
TEST_DB_NAME=design_platform_test
TEST_DB_USER=design_user
TEST_DB_PASSWORD=design_password
TEST_DB_HOST=localhost
TEST_DB_PORT=5432

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# Celery Configuration
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# JWT Configuration
JWT_ACCESS_TOKEN_LIFETIME=3600
JWT_REFRESH_TOKEN_LIFETIME=604800

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000

# AWS S3 Configuration
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
AWS_INTERNAL_ENDPOINT_URL=http://localstack:4566
AWS_EXTERNAL_ENDPOINT_URL=http://localhost:4566
AWS_S3_BUCKET=design-platform-assets
AWS_S3_EXPORT_BUCKET=design-platform-exports

# Production:
# AWS_REGION=ap-south-1
# AWS_S3_BUCKET=production-design-assets
# AWS_S3_EXPORT_BUCKET=production-design-exports
# Leave both endpoint URLs empty/unset and use an IAM role for AWS credentials.
# Keep bucket public access blocked; configure S3 CORS for the deployed web origin.

# Logging
LOG_LEVEL=INFO

# Feature Flags
ENABLE_TEMPLATES=True
ENABLE_EXPORT=True
ENABLE_SHARING=True
