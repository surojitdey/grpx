# Test database configuration (optional).
#
# Copy to `.env.test` to run the pytest suite against a dedicated database or
# server. Every key is optional: anything you leave out falls back to the value
# in `.env`, with the database name defaulting to `<DB_NAME>_test`.
#
# `.env.test` is only read by pytest (see conftest.py), never by the dev server.

TEST_DB_NAME=grpx_test
TEST_DB_USER=surojit
TEST_DB_PASSWORD=password
TEST_DB_HOST=localhost
TEST_DB_PORT=5432
